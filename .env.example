# ============================================================
# OhmyTesla 配置 / Configuration
# 复制为 .env 并修改: cp .env.example .env
# ============================================================

# ---------- TeslaMate 核心 (必填) ----------
# 用于加密你的 Tesla API Token，请改成一个随机长字符串
TM_ENCRYPTION_KEY=change-me-to-a-random-secret
# TeslaMate 数据库账号密码
TM_DB_USER=teslamate
TM_DB_PASS=change-me-db-password
TM_DB_NAME=teslamate

# ---------- 端口 ----------
TESLAMATE_PORT=4000     # TeslaMate 原生界面
GRAFANA_PORT=3000       # Grafana 数据面板
OHMYTESLA_PORT=8800     # OhmyTesla 统一门户（哨兵告警 / 行车记录仪工作室 / 数据洞察）

# ---------- 行车记录仪 (Dashcam Studio) ----------
# 你的 TeslaCam 素材目录（把 U 盘里的 TeslaCam 文件夹拷贝到这里，
# 或用 teslausb 之类的方案自动同步到这里）
TESLACAM_DIR=./data/teslacam
# TeslaCam 文件名使用的时区（用于和 TeslaMate 遥测数据对齐）
# 中国大陆: Asia/Shanghai；留空则使用容器系统时区
TESLACAM_TZ=Asia/Shanghai

# ---------- 哨兵/安全告警通知渠道 (至少配置一种) ----------
# 方式 A: 邮件 SMTP —— 用你自己的邮箱发给你自己（QQ/163/Gmail 均可）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# 方式 B: ntfy 推送（最简单的手机推送，装个 ntfy App 订阅一个主题即可，无需注册）
# 例如 https://ntfy.sh + 一个你自己起的隐蔽主题名
NTFY_URL=
NTFY_TOPIC=

# 方式 C: Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 方式 D: 任意 Webhook（企业微信/钉钉/飞书机器人等，POST JSON）
ALERT_WEBHOOK_URL=

# 方式 E: 高级 —— 直接填 Apprise URL 列表（逗号分隔，支持 100+ 服务）
# 参考 https://github.com/caronc/apprise/wiki
#
# 【国内用户强烈推荐 Bark】iOS 上唯一能发"关键警报"（穿透勿扰模式/静音）的方案，
# 直连苹果推送服务，不经过任何墙外中转，延迟最低：
#   App Store 装 Bark → 复制它给的 key → 填成：
#   barks://api.day.app/你的KEY/?level=critical&volume=8&call=yes
#   （需在 iOS 设置 → 通知 → Bark 里手动允许"关键警报"）
# 其他国内渠道（都已内置，直接填 URL 即可）：
#   PushDeer:  pushdeer://pushdeer.example.com/PUSHKEY
#   Server酱:  sc://SENDKEY
#   企业微信:  wecombot://WEBHOOK_KEY
#   钉钉:      dingtalk://TOKEN
#   WxPusher:  wxpusher://APPTOKEN/UID
# ⚠️ Telegram 在中国大陆需要代理才能收到，不适合作为唯一渠道。
APPRISE_URLS=

# ---------- 哨兵活动灵敏度 ----------
# 连续活动合并成一次会话的窗口（秒）——防止一晚上被推几百条
SENTRY_DEDUP_SECONDS=15
# 活动持续超过这么久，或这么久内再次触发，就升级为高优先级推送
SENTRY_ESCALATE_SECONDS=90
# 是否启用"轮询推断"层（零配置的普通哨兵触发推送，30 秒采样可能漏报）
# 接入 Fleet Telemetry 后这层会自动让位
SENTRY_POLLED_ALERTS=true
# 多久收不到车辆数据就判定"采集中断"并严重告警（秒）。
# 这是安防产品的关键保险：采集停了但界面一切正常，是最危险的失败模式。
DATA_STALE_SECONDS=1800

# ---------- 告警行为 ----------
ALERT_QUIET_HOURS=      # 静默时段，如 23:00-07:00，留空则不静默
ALERT_COOLDOWN_SECONDS=300   # 同类告警最小间隔（防轰炸）
ALERT_LANG=zh           # 通知语言 zh / en

# ---------- 门户安全 ----------
# 设置后整个门户需要登录（用户名 ohmytesla + 此密码）。
# 强烈建议：只要有任何公网可达的可能就设置它。
OHMYTESLA_PASSWORD=

# ---------- 通知里的链接 ----------
# 推送正文里的链接用什么地址打开。留空的话只能给相对路径，
# 手机上等于点不动 —— 想让「查看录像」这类链接可用就必须填。
# 填手机能访问到这台机器的地址：局域网 IP 或反代域名。
#   macOS 查本机 IP: ipconfig getifaddr en0
PUBLIC_URL=

# ---------- 地图 ----------
# 行程轨迹地图瓦片源。留空时按地区自动选：
#   中国大陆 → 高德栅格瓦片（GCJ-02 基准）
#   其余     → CARTO dark_all 深色底图（与暗色界面一致）
TILE_URL=
# 瓦片坐标基准: wgs84 | gcj02。只有自己填了 TILE_URL 才需要指定。
# 填错会让轨迹整体偏移 50-500 米（数据库里存的一律是 WGS-84）。
TILE_DATUM=

# ---------- ABRP 实时遥测（A Better Routeplanner）----------
# 把真实电量/车速/位置/功率喂给 ABRP，路线规划就按你这台车的实际状态算，
# 而不是车型的平均能耗模型。token 在 ABRP 里「Settings → Live Data →
# 生成 token」拿（每辆车一个）。
ABRP_ENABLED=false
ABRP_TOKEN=
# 只发电量不发经纬度（ABRP 仍能用 SOC 估算，但不知道你在哪）
ABRP_SKIP_LOCATION=false

# ---------- MQTT ----------
# 默认连编排里的 mosquitto，无需改动。
# 只有在你换成自己的、带认证的 broker 时才需要这几项。
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# 对应 TeslaMate 的 MQTT_NAMESPACE，通常留空
MQTT_NAMESPACE=

# ---------- 车辆控制（鸣笛/闪灯/空调/充电等）----------
# 默认无需配置：hub 与 TeslaMate 共用 TM_ENCRYPTION_KEY，会自动复用其登录 token。
# 中国大陆车主如果 TeslaMate 用的是国内接口，这里填相同地址：
#   https://owner-api.vn.cloud.tesla.cn
TESLA_API_HOST=https://owner-api.teslamotors.com
# 2021 年后的车型经 Fleet API 下发指令需要"签名指令"代理（官方 vehicle-command）
TESLA_COMMAND_PROXY=
# 可选：手动指定 access token（一般不需要）
TESLA_ACCESS_TOKEN=

# ---------- 充电成本 ----------
# 把 OhmyTesla 算出的充电费用回写进 TeslaMate 的 cost 字段，
# 这样 Grafana 自带的充电面板也能看到钱。电价方案在网页「设置」里配。
COST_WRITE_BACK=false

# ---------- 实时哨兵：托管中转（推荐，无需公网 IP）----------
# 想要"有人靠近立刻推送、绝不漏报"，需要 Tesla 官方遥测流。
# 自建服务器要公网 IP + 证书（多数人做不到），但可以用中转服务代劳：
# 车辆把数据推给中转商，本套件从家里主动向外拉一条长连接——不用开任何入站端口。
#
# 【Teslemetry】协议已核实，约 $30/年/车：
#   1. teslemetry.com 注册并授权特斯拉账号、配对虚拟钥匙
#   2. 在其后台把 SentryMode 字段打开（interval_seconds=1）
#   3. 下面填 true + 你的 token
# 【实验性】tessie / myteslamate 协议未经真实 token 验证，可能需要微调
FLEET_BRIDGE_ENABLED=false
FLEET_BRIDGE_PROVIDER=teslemetry
FLEET_BRIDGE_TOKEN=
# 高级：自定义中转地址（{vin} 为占位符），留空则用上面 provider 的预设
FLEET_BRIDGE_URL=
FLEET_BRIDGE_TRANSPORT=
FLEET_BRIDGE_VINS=

# ---------- Fleet Telemetry 自建（进阶，需公网 IP）----------
# 自托管官方遥测流后可获得哨兵 Aware/Panic 真实事件推送
# 配置步骤见 docs/FLEET-TELEMETRY.md；启用: docker compose --profile fleet up -d
FLEET_TOPIC_PREFIX=telemetry
# 车辆断线重连后会重放最多数千条缓冲消息，而官方 MQTT 派发器丢掉了
# created_at/is_resend，没法区分新旧。所以重连后这段时间内的哨兵状态
# 不当作新事件 —— 否则断一次网就会连发一串"有人在你车旁"的假告警。
FLEET_REPLAY_GATE_SECONDS=60

# ---------- Home Assistant ----------
# 把 OhmyTesla 自己算出来的实体（哨兵会话、采集中断、停放耗电、待办保养）
# 用 MQTT 自动发现推给 HA。车辆本身那 60 来个实体由 TeslaMate v4.1.0 自带的
# 发现负责，这里不重复发，否则 HA 里会出现两套。
HASS_DISCOVERY=false
